#!/usr/bin/env python3
from pathlib import Path
import sys


if sys.argv[1:] == ["--version"]:
    print("Rojo 7.5.1")
    executable = Path(sys.argv[0])
    executable.chmod(0o700)
    with executable.open("ab") as stream:
        stream.write(b"\n# mutated after version check\n")
    raise SystemExit(0)

print("self-mutating fixture reached build", file=sys.stderr)
raise SystemExit(97)
